+            > available_end_us
+        ):
+            raise ValueError("Manual RGB response windows fall outside the retained recording.")
+        bin_us = TIMING.flash_detection_bin_us
+        left = max(0, int(onsets[0]) - 2 * TIMING.flash_period_us) // bin_us * bin_us
