+    if MANUAL_FIRST_ONSET_US is None:
+        detection = detect_flash_onsets_chunked(
+            DATA_FILE,
+            read_start_position,
+            actual_start_timestamp,
+            actual_read_start_us,
+            output_dir,
+            TIMING,
+            FLASH_SEARCH,
+        )
+    else:
+        onsets = build_fixed_flash_onsets(
+            int(MANUAL_FIRST_ONSET_US) - actual_read_start_us, TIMING
+        )
